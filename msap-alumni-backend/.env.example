# =============================================================================
# MSAP Alumni Backend — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in the real values.
#   cp .env.example .env
#
# IMPORTANT: .env is in .gitignore and must NEVER be committed to Git.
#            Only this .env.example (with placeholder values) is safe to commit.
# =============================================================================

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── Supabase Configuration ───────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
# New Supabase naming:
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Or legacy Supabase naming (both are supported):
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── JWT & Authentication ─────────────────────────────────────────────────────
# Generate a cryptographically secure secret for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=super_secret_jwt_key_msap_alumni_change_in_production_min32chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
REGISTRATION_RATE_LIMIT_MAX=5

# ─── Email / SMTP Configuration ───────────────────────────────────────────────
# Using Gmail SMTP:
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to Google Account → Security → App Passwords.
#   3. Generate an App Password for "Mail" and paste the 16-char code below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=your_16char_app_password
SMTP_FROM=MSAP Alumni <your.gmail@gmail.com>

# Email address of the NGO head who receives new-registration alerts.
NOTIFY_EMAIL=alumni.msap1973@gmail.com

# Full URL for the admin dashboard link embedded in notification emails.
ADMIN_URL=https://your-frontend-domain.com/admin

# ─── DKIM Email Signing (Optional — strongly recommended for production) ────
# DKIM prevents email spoofing and improves deliverability.
#
# Setup steps:
#   1. Generate a 2048-bit RSA key pair:
#        openssl genrsa -out dkim-private.pem 2048
#        openssl rsa -in dkim-private.pem -pubout -out dkim-public.pem
#   2. Add a TXT record to your DNS:
#        Name:  mail._domainkey.yourdomain.com
#        Value: v=DKIM1; k=rsa; p=<base64-encoded-public-key>
#   3. Set DKIM_PRIVATE_KEY below (replace real newlines with \n for env vars).
#
DKIM_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----
DKIM_DOMAIN=yourdomain.com
DKIM_KEY_SELECTOR=mail

# ─── Email Test Mode ──────────────────────────────────────────────────────────
# Set to "true" in CI / test environments to suppress real email sends.
# All emails will be logged to the console instead of being delivered.
EMAIL_TEST_MODE=false
